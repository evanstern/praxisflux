{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxisflux.invalid/explainer/contents.schema.json",
  "title": "explainer contents.json",
  "description": "Structure, terms, sources and generators for one explainer artifact. Validated by lib/contents.mjs, which interprets a built-ins-only subset of this vocabulary (type, const, enum, pattern, minLength, minItems, properties, required, additionalProperties, items, oneOf) — no external schema engine.",
  "type": "object",
  "required": ["schema", "title", "kind", "brand", "groups", "pages", "terms", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1,
      "description": "contents.json format version. Only 1 is understood."
    },
    "title": {
      "type": "string",
      "pattern": "^\\S+(\\s+\\S+){1,3}$",
      "description": "2-4 words; becomes <title> (house style rule title.name)."
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Profile id, resolved through the lookup as profiles/<kind>."
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "description": "Brand file id, resolved through the lookup as brand/<brand>.css."
    },
    "voice": {
      "type": "string",
      "minLength": 1,
      "description": "Tone skill name, or \"none\"."
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "ref"],
      "properties": {
        "github": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "group", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "panels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "title", "body"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "body": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "term", "def"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "term": { "type": "string", "minLength": 1 },
          "def": { "type": "string", "minLength": 1 },
          "see": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "file" },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!.*\\s)(?!.*\\.\\.).+$",
                "description": "No whitespace and no \"..\"/\"...\" range syntax — a value like that is a diff range, not a file path; use kind:\"diff\" with a \"range\" field instead."
              },
              "line": { "type": "integer" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "url"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "url" },
              "url": { "type": "string", "minLength": 1 },
              "vendor": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "range"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "diff" },
              "range": {
                "type": "string",
                "minLength": 1,
                "description": "The diff range exactly as run, e.g. \"origin/master...HEAD\"."
              },
              "files": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    },
    "generators": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["cmd"],
            "properties": {
              "cmd": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string", "minLength": 1 },
              "timeout": { "type": "integer" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["builtin"],
            "properties": {
              "builtin": { "const": "git-manifest" },
              "range": { "type": "string", "minLength": 1 },
              "buckets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "match"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1 },
                    "match": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "off": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "on": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comments": { "type": "boolean" },
        "presenter": { "type": "boolean" }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": ["string", "null"] },
        "shape": { "enum": ["single", "multi"] }
      }
    }
  }
}
