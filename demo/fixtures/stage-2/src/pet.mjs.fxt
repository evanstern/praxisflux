// pet.mjs — the praxis-pet state machine: a pure, dependency-free virtual pet.
// Every verb returns a NEW pet object; nothing here touches the filesystem.

const clamp = (n) => Math.max(0, Math.min(100, Math.round(n)));

export function newPet(name = "Mochi") {
  return { name, hunger: 30, happiness: 70, energy: 80, age: 0, alive: true };
}

export function feed(pet) {
  if (!pet.alive) return pet;
  return { ...pet, hunger: clamp(pet.hunger - 25), happiness: clamp(pet.happiness + 5) };
}

export function play(pet) {
  if (!pet.alive) return pet;
  return {
    ...pet,
    happiness: clamp(pet.happiness + 20),
    energy: clamp(pet.energy - 15),
    hunger: clamp(pet.hunger + 10),
  };
}

export function rest(pet) {
  if (!pet.alive) return pet;
  return { ...pet, energy: clamp(pet.energy + 30), hunger: clamp(pet.hunger + 5) };
}

/** One unit of time: everything drifts, and neglect is eventually fatal. */
export function tick(pet) {
  if (!pet.alive) return pet;
  const next = {
    ...pet,
    age: pet.age + 1,
    hunger: clamp(pet.hunger + 10),
    energy: clamp(pet.energy - 5),
    happiness: clamp(pet.happiness - 5),
  };
  if (next.hunger >= 100 || next.energy <= 0) next.alive = false;
  return next;
}

export function mood(pet) {
  if (!pet.alive) return "gone";
  if (pet.hunger >= 70) return "hungry";
  if (pet.energy <= 30) return "tired";
  if (pet.happiness >= 60) return "happy";
  return "okay";
}
