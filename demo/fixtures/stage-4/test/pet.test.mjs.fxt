import test from "node:test";
import assert from "node:assert/strict";
import { newPet, feed, play, rest, tick, mood, moodFace, rename } from "../src/pet.mjs";

test("newPet starts alive with sane stats", () => {
  const pet = newPet("Pixel");
  assert.equal(pet.name, "Pixel");
  assert.equal(pet.alive, true);
  assert.ok(pet.hunger < 100 && pet.energy > 0);
});

test("feed lowers hunger and never goes below zero", () => {
  let pet = newPet();
  pet = feed(feed(feed(pet)));
  assert.equal(pet.hunger, 0);
});

test("play trades energy for happiness", () => {
  const pet = newPet();
  const played = play(pet);
  assert.ok(played.happiness > pet.happiness);
  assert.ok(played.energy < pet.energy);
});

test("rest restores energy, capped at 100", () => {
  let pet = newPet();
  pet = rest(rest(pet));
  assert.equal(pet.energy, 100);
});

test("tick ages the pet and starvation is fatal", () => {
  let pet = newPet();
  for (let i = 0; i < 20 && pet.alive; i++) pet = tick(pet);
  assert.equal(pet.alive, false);
  assert.equal(mood(pet), "gone");
});

test("verbs are no-ops on a gone pet", () => {
  let pet = { ...newPet(), alive: false };
  assert.equal(feed(pet), pet);
  assert.equal(play(pet), pet);
  assert.equal(rest(pet), pet);
  assert.equal(tick(pet), pet);
});

test("mood reflects the dominant need", () => {
  assert.equal(mood(newPet()), "happy");
  assert.equal(mood({ ...newPet(), hunger: 80 }), "hungry");
  assert.equal(mood({ ...newPet(), energy: 20 }), "tired");
});

test("rename sets a trimmed name and keeps the old one when empty", () => {
  const pet = newPet("Mochi");
  assert.equal(rename(pet, "  Pixel  ").name, "Pixel");
  assert.equal(rename(pet, "   ").name, "Mochi");
});

test("rename is refused on a gone pet", () => {
  const pet = { ...newPet("Mochi"), alive: false };
  assert.equal(rename(pet, "Pixel"), pet);
});

test("every mood has a face; unknown moods fall back", () => {
  assert.equal(moodFace(newPet()), "😊");
  assert.equal(moodFace({ ...newPet(), happiness: 40 }), "😐");
  assert.equal(moodFace({ ...newPet(), hunger: 80 }), "😋");
  assert.equal(moodFace({ ...newPet(), energy: 20 }), "😴");
  assert.equal(moodFace({ ...newPet(), alive: false }), "🪦");
  assert.equal(moodFace(newPet(), "confused"), "😐");
});
